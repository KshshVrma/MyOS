      "id": "94629fdc-87de-4d0f-bca2-5ce095d96980",
      "name": "If"
    },
    {
      "parameters": {
        "jsCode": "\nconst raw = $input.first().json.text;\n\nif (!raw) {\n  throw new Error(\"LLM returned an empty response\");\n}\n\nconst cleaned = raw\n  .replace(/^```(?:json)?\\s*/i, \"\")\n  .replace(/\\s*```$/i, \"\")\n  .trim();\n\nlet parsed;\n\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (error) {\n  throw new Error(`Invalid JSON: ${error.message}`);\n}\n\nconst data = parsed.output ?? parsed;\n\nconst { intent, description, date, time, response } = data;\n\nconst allowedIntents = [\n  \"CREATE_TASK\",\n  \"CREATE_REMINDER\",\n  \"ASK_QUESTION\",\n  \"GENERAL_CHAT\"\n];\n\nif (!allowedIntents.includes(intent)) {\n  throw new Error(\"Invalid intent\");\n}\n\nif (!description?.trim() && !response?.trim()) {\n  throw new Error(\"Description is missing\");\n}\n\nlet reminderAt = null;\nlet endAt = null;\n\nif (date && time) {\n  const dateMatch = date.match(/^(\\d{4})-(\\d{2})-(\\d{2})$/);\n  const timeMatch = time.match(/^([01]\\d|2[0-3]):([0-5]\\d)$/);\n\n  if (!dateMatch || !timeMatch) {\n    throw new Error(\"Invalid date or time format\");\n  }\n\n  const [, year, month, day] = dateMatch.map(Number);\n  const [, hours, minutes] = timeMatch.map(Number);\n\n  const localDate = new Date(\n    Date.UTC(year, month - 1, day, hours, minutes)\n  );\n\n  // Reject impossible calendar dates\n  if (\n    localDate.getUTCFullYear() !== year ||\n    localDate.getUTCMonth() !== month - 1 ||\n    localDate.getUTCDate() !== day\n  ) {\n    throw new Error(\"Invalid calendar date\");\n  }\n\n  // Convert Asia/Kolkata (UTC+05:30) to UTC\n  reminderAt = new Date(\n    localDate.getTime() - 330 * 60 * 1000\n  ).toISOString();\n\n  // Default reminder duration: 15 minutes\n  endAt = new Date(\n    Date.parse(reminderAt) + 15 * 60 * 1000\n  ).toISOString();\n}\n\nreturn [{\n  json: {\n    output: {\n      intent,\n      description: description || response,\n      date,\n      time,\n      response: response || description\n    },\n    reminderAt,\n    endAt,\n    timezone: \"Asia/Kolkata\",\n    status: \"VALIDATED\"\n  }\n}];\n"
      },
